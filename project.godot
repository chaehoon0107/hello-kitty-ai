config_version=5

[application]
config/name="나만의 데스크톱 펫"
run/main_scene="res://main.tscn"
boot_splash/show_image=false
boot_splash/bg_color=Color(0,0,0,0)

[display]
window/size/viewport_width=500
window/size/viewport_height=600
window/size/window_width_override=500
window/size/window_height_override=600
window/per_pixel_transparency/allowed=true
window/size/transparent=true
window/size/borderless=true
window/size/always_on_top=true

[rendering]
viewport/transparent_background=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0,0,0,0)

[physics]
common/physics_interpolation=true
common/physics_ticks_per_second=60
2d/default_gravity=1600.0
